<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>kl!ck</title>
    <options customize="never" require-scripts="true" hostArchitectures="@ARCH@"/>
    <domains enable_localSystem="true"/>
    <allowed-os-versions>
        <os-version min="12.0"/>
    </allowed-os-versions>
    <choices-outline>
        <line choice="default">
            <line choice="app.klick.pkg"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="app.klick.pkg" visible="false">
        <pkg-ref id="app.klick.pkg"/>
    </choice>
    <pkg-ref id="app.klick.pkg" version="@VERSION@" onConclusion="none">klick.pkg</pkg-ref>
</installer-gui-script>
