#!/bin/bash
# После установки: служба копируется в /Library/PrivilegedHelperTools/klick и регистрируется в launchd.
# Если VPN был включён до обновления, служба включит его снова.
set -e
APP="/Applications/kl!ck.app"
LSREGISTER="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"
# Метку карантина с программы снимает служба при установке (не /usr/bin/xattr: тот написан на Python
# и на Mac без инструментов разработчика просит их поставить).
"$APP/Contents/MacOS/klick-service" install

# Ссылки klick:// — сразу после установки, до первого запуска kl!ck: зарегистрировать программу
# в LaunchServices (у root и у того, кто сейчас за Mac — у каждого пользователя своя база).
"$LSREGISTER" -f "$APP" || true
user="$(/usr/bin/stat -f%Su /dev/console)"
if [[ -n "$user" && "$user" != "root" && "$user" != "loginwindow" ]]; then
    uid="$(/usr/bin/id -u "$user")"
    /bin/launchctl asuser "$uid" /usr/bin/sudo -u "$user" "$LSREGISTER" -f "$APP" || true
    # Открыть окно у того, кто сейчас за Mac (установка идёт от root).
    /bin/launchctl asuser "$uid" /usr/bin/sudo -u "$user" /usr/bin/open "$APP" || true
fi
exit 0
