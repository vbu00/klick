{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "klick",
  "identifier": "app.klick.ios",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://127.0.0.1:5173"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "kl!ck",
        "backgroundColor": "#1a1a1d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "iOS": {
      "minimumSystemVersion": "15.0"
    },
    "icon": [
      "../klick-ui/icons/32x32.png",
      "../klick-ui/icons/128x128.png",
      "../klick-ui/icons/icon.png",
      "../klick-ui/icons/icon.ico"
    ]
  }
}
