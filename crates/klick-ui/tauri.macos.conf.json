{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "kl!ck",
        "width": 380,
        "height": 720,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 16 },
        "resizable": false,
        "maximizable": false,
        "center": true,
        "visible": false,
        "shadow": true,
        "backgroundColor": "#1a1a1d"
      },
      {
        "label": "tray",
        "title": "kl!ck",
        "url": "index.html",
        "width": 320,
        "height": 600,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "acceptFirstMouse": true,
        "visible": false,
        "shadow": true,
        "focus": true,
        "backgroundColor": "#1a1a1d"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "public.app-category.utilities",
    "copyright": "© vbu00, Dmitriy Medvedev · порт на macOS — limeflash",
    "icon": ["icons/icon.icns", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
