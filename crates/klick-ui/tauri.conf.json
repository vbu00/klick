{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kl!ck",
  "version": "0.4.0",
  "identifier": "app.klick.desktop",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://127.0.0.1:5173"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "kl!ck",
        "width": 380,
        "height": 720,
        "decorations": false,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "visible": false,
        "shadow": true,
        "backgroundColor": "#1a1a1d"
      },
      {
        "label": "tray",
        "title": "kl!ck",
        "url": "index.html",
        "width": 320,
        "height": 600,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visible": false,
        "shadow": true,
        "focus": true,
        "backgroundColor": "#1a1a1d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
