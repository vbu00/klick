<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- macOS: ссылки klick://add со страниц подписок открывают kl!ck. Tauri дополняет этим Info.plist пакета;
	     build.sh проверяет, что схема в нём есть. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.klick.desktop</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>klick</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
