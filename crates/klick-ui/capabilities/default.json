{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Окно kl!ck и окно трея: свои кнопки заголовка, события службы, выбор программы, ссылки в браузере, автозапуск",
  "windows": [
    "main",
    "tray"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-hide",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "opener:default",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled"
  ]
}
